# Copy to .env and fill in. .env is gitignored -- never commit real values.

# PostgreSQL connection string (local dev: see README "Run locally").
DATABASE_URL=postgresql://corrobo:changeme@localhost:5432/corrobo

# Google Gemini API key. Optional: without it the app still runs, but
# claim checking is disabled (endpoints return 503, UI shows a banner).
GEMINI_API_KEY=your-gemini-api-key-here

# Secret for signing login tokens (JWT). Generate with: openssl rand -hex 32
# If unset, a random one is generated per process (logins reset on restart).
JWT_SECRET=replace-with-a-long-random-string

# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-3.5-flash
# MAX_CLAIMS_PER_CHECK=25
# JWT_EXPIRE_MINUTES=1440
# CHROMA_PATH=./chroma_data
# CORS_ORIGINS=http://localhost:5173
